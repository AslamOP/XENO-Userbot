API_ID=123456
API_HASH=your_api_hash_here
SESSION_NAME=userbot_session
OWNER_ID=your_telegram_user_id

# AI (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Crypto (optional — needed only by .ethgas)
ETHSCAN_API_KEY=

# Prefixes (comma separated)
PREFIXES=.,!,#

# Auto-reply in DMs (set to "true" to enable). OFF by default: it spends an API
# call per inbound message. AI_ALLOWED_IDS is a comma-separated user-id allowlist;
# leave blank to allow anyone.
AI_AUTO_REPLY=false
AI_ALLOWED_IDS=

# Logging chat (optional - send logs here)
LOG_CHAT_ID=

# ---------------------------------------------------------------------------
# Assistant / control-panel bot (second Telegram client)
# ---------------------------------------------------------------------------
# XENO ships two Telegram identities: the userbot (you) and an assistant bot
# you DM to configure it. Every `.command` is outgoing=True, so only your own
# messages trigger it — the bot gives you an out-of-band path.
ASSISTANT_ENABLED=true

# XENO creates the assistant bot for you via @BotFather on first boot: named
# "Assistant Bot", handle <your username>_bot (retries if taken). It scrapes
# the token, stores it, and never runs this flow again.
AUTO_BOTFATHER=true

# Set BOT_TOKEN to skip BotFather entirely and use a bot you made yourself.
# Takes priority over AUTO_BOTFATHER.
BOT_TOKEN=

# Overrides for the auto-created bot.
ASSISTANT_NAME=Assistant Bot
ASSISTANT_USERNAME=

# Prefix for panel commands. Keep it distinct from PREFIXES.
ASSISTANT_PREFIX=/

# Set the new bot's bio + description via BotFather at creation time.
ASSISTANT_DECORATE=true
